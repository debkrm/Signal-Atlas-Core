# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
data/reference/** text eol=lf
configs/** text eol=lf
# Audit §79.7 (N-154): the audit volumes are frozen by sha256, so their bytes are part of the
# verification instrument. Pin them to LF in the working copy as well as in the stored blob.
reports/audit/** text eol=lf

